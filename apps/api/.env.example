NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://volkoff:volkoff@localhost:5433/volkoff?schema=public

# Публичные адреса (используются в ссылках из писем и в CORS)
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Секрет для подписи JWT — минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# Кто становится админом при регистрации / сиде (через запятую)
ADMIN_EMAILS=admin@volkoffmvs.com
# Пароль админа для сида (только dev; в проде задаётся при первом входе через reset)
SEED_ADMIN_PASSWORD=admin12345

# ---------- Почта ----------
# MAIL_TRANSPORT: smtp | direct | log
#   smtp   — отправка через SMTP-сервер (в dev — Mailpit из docker-compose)
#   direct — бэкенд сам доставляет письма на MX получателя (нужны DKIM + SPF + PTR, см. docs/MAIL.md)
#   log    — письма только пишутся в лог
MAIL_TRANSPORT=smtp
MAIL_FROM="VOLKOFF <no-reply@volkoffmvs.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Для direct-режима
MAIL_HELO_NAME=mail.volkoffmvs.com
DKIM_DOMAIN=volkoffmvs.com
DKIM_SELECTOR=volkoff
DKIM_PRIVATE_KEY_PATH=./secrets/dkim.private.pem

# ---------- Оплата ----------
# mock — тестовый провайдер (кнопка «оплатить» без денег). Реальные провайдеры — см. docs/PAYMENTS.md
PAYMENT_PROVIDER=mock

UPLOADS_DIR=./uploads
