generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  nickname           String       @unique
  avatarSeed         String
  role               Role         @default(USER)
  locale             String       @default("ru")
  emailVerifiedAt    DateTime?
  fullName           String?
  phone              String?
  consentAt          DateTime?
  /// Открытые на сайте достижения (игры, пасхалки); серверные считаются на лету
  achievements       String[]     @default([])
  avatarRerolledAt   DateTime?
  nicknameRerolledAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  sessions           Session[]
  emailTokens        EmailToken[]
  orders             Order[]
}

/// Refresh-сессия. В БД лежит только sha256 от токена.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Когда токен заменили новым при обновлении (в отличие от выхода, где только revokedAt)
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([userId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

enum MailStatus {
  PENDING
  SENT
  FAILED
}

/// Очередь исходящих писем: запросы не ждут SMTP, воркер отправляет с ретраями.
model MailOutbox {
  id        String     @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  status    MailStatus @default(PENDING)
  attempts  Int        @default(0)
  lastError String?
  sendAfter DateTime   @default(now())
  sentAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([status, sendAfter])
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameRu    String
  nameEn    String
  sortOrder Int       @default(0)
  products  Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  /// Артикул на витрине, например «VK-007»
  code          String           @unique
  nameRu        String
  nameEn        String
  descriptionRu String           @default("")
  descriptionEn String           @default("")
  /// копейки
  priceRub      Int
  /// центы
  priceUsd      Int
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          String[]         @default([])
  status        ProductStatus    @default(DRAFT)
  isFeatured    Boolean          @default(false)
  sortOrder     Int              @default(0)
  /// Дата выхода: 14 дней после неё вещь — «новинка», по ней же сортировка «новое»
  releasedAt    DateTime         @default(now())
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, sortOrder])
  @@index([releasedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  stock      Int         @default(0)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size])
}

enum Currency {
  RUB
  USD
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique @default(autoincrement())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         OrderStatus @default(PENDING_PAYMENT)
  currency       Currency
  paymentMethod  String
  subtotal       Int
  shippingCost   Int         @default(0)
  total          Int
  fullName       String
  phone          String
  email          String
  country        String
  city           String
  address        String
  postalCode     String      @default("")
  comment        String      @default("")
  trackingNumber String?
  adminNote      String?
  /// Пока заказ не оплачен, товар зарезервирован до этого момента
  expiresAt      DateTime?
  items          OrderItem[]
  payments       Payment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  nameRu    String
  nameEn    String
  image     String?
  size      String
  unitPrice Int
  quantity  Int
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          Currency
  redirectUrl       String?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

/// Редактируемые тексты сайта (ключ → RU/EN)
model SiteContent {
  key       String   @id
  ru        String   @default("")
  en        String   @default("")
  updatedAt DateTime @updatedAt
}

/// Новости / анонсы над каталогом
model News {
  id          String   @id @default(cuid())
  titleRu     String
  titleEn     String
  textRu      String   @default("")
  textEn      String   @default("")
  imageUrl    String?
  linkUrl     String?
  linkLabelRu String   @default("")
  linkLabelEn String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Настройки сайта из админки (рожицы корзины, лента тегов…): ключ → JSON
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
