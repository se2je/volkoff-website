{
  "name": "volkoff",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @volkoff/api & npm run dev --workspace @volkoff/web",
    "dev:api": "npm run dev --workspace @volkoff/api",
    "dev:web": "npm run dev --workspace @volkoff/web",
    "build": "npm run build --workspace @volkoff/api && npm run build --workspace @volkoff/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace @volkoff/web",
    "db:up": "docker compose up -d postgres mailpit",
    "db:migrate": "npm run db:migrate --workspace @volkoff/api",
    "db:seed": "npm run db:seed --workspace @volkoff/api",
    "db:studio": "npm run db:studio --workspace @volkoff/api"
  }
}
